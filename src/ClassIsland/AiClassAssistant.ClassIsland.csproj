<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AiClassAssistant.ClassIsland</RootNamespace>
    <AssemblyName>AiClassAssistant.ClassIsland</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.Shared.IPC" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/AiClassAssistant.Core.csproj" />
  </ItemGroup>

</Project>
