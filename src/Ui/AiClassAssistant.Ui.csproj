<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AiClassAssistant.Ui</RootNamespace>
    <AssemblyName>AiClassAssistant.Ui</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/AiClassAssistant.Core.csproj" />
    <ProjectReference Include="../Perception/AiClassAssistant.Perception.csproj" />
    <ProjectReference Include="../ClassIsland/AiClassAssistant.ClassIsland.csproj" />
  </ItemGroup>

</Project>
